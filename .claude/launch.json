{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Frontend - Vite",
      "runtimeExecutable": "C:/Program Files/nodejs/node.exe",
      "runtimeArgs": [
        "node_modules/vite/bin/vite.js",
        "--port",
        "5173"
      ],
      "cwd": "frontend",
      "port": 5173
    },
    {
      "name": "Backend - FastAPI",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--reload",
        "--port",
        "8000"
      ],
      "cwd": "backend",
      "port": 8000
    }
  ]
}