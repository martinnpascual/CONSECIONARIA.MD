# ==========================================
# DM Cars — Variables de Entorno
# Copiar este archivo a .env y completar
# NUNCA commitear el .env al repositorio
# ==========================================

# ── Supabase ──────────────────────────────
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── JWT (del panel Supabase → Settings → API → JWT Secret) ──
JWT_SECRET=tu-jwt-secret-de-supabase
JWT_ALGORITHM=HS256

# ── MrBot API (Facturación Electrónica) ──
MRBOT_EMAIL=
MRBOT_API_KEY=

# ── ARCA / AFIP ───────────────────────────
AFIP_CUIT=
AFIP_PUNTO_VENTA=1
AFIP_TESTING=true
# Rutas a los certificados digitales (NO commitear los .crt y .key)
AFIP_CERT_PATH=./app/certs/cert.crt
AFIP_KEY_PATH=./app/certs/private.key

# ── Backend App ───────────────────────────
APP_NAME=DM Cars
APP_ENV=development
DEBUG=true
PORT=8000
# URL del frontend (para CORS)
FRONTEND_URL=http://localhost:5173

# ── Frontend (Vite) ───────────────────────
# Estas variables deben tener el prefijo VITE_ para ser accesibles en React
VITE_API_URL=http://localhost:8000/api/v1
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
# NUNCA poner el SERVICE_ROLE_KEY en las variables VITE_

# ── Base de datos (solo para herramientas locales) ──
# La conexión real se hace via Supabase SDK, no directamente
DATABASE_URL=postgresql://postgres:[password]@db.tu-proyecto.supabase.co:5432/postgres
